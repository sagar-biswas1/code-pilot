API_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

OPENAI_API_KEY=
GEMINI_API_KEY=

# Sentry — leave SENTRY_DSN empty to disable reporting entirely
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# 0..1 — defaults to 1.0 outside production, 0.1 in production
SENTRY_TRACES_SAMPLE_RATE=1.0
# true also sends request bodies, cookies and IPs; off by default
SENTRY_SEND_PII=false
SENTRY_DEBUG=false
CLERK_OAUTH_CLIENT_SECRET=
CLERK_OAUTH_CLIENT_ID=
JWT_SECRET=
CLERK_FRONTEND_API=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
POLAR_ACCESS_TOKEN =
POLAR_PRODUCT_ID =
POLAR_SERVER=sandbox
POLAR_CREDITS_METER_ID=
