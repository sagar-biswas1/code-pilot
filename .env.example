# --- Core -------------------------------------------------------------------
# Public origin of the server. Must match the redirect URI registered with
# Clerk — the CLI's browser login bounces through it.
API_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Model providers --------------------------------------------------------
# At least one is required. Supply the key for whichever models you offer in
# packages/shared/src/models.ts; google and azure entries there have no SDK
# wired up and are rejected at validation time.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Auth -------------------------------------------------------------------
# Signs the CLI's session token. Use a strong random value, distinct per
# environment.
JWT_SECRET=
CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_ID=
# Never leaves the server — it is the whole reason the CLI delegates the
# token exchange instead of talking to Clerk directly.
CLERK_OAUTH_CLIENT_SECRET=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- Billing ----------------------------------------------------------------
# The meter must filter on event name `codepilot_usages` and sum
# `metadata.credits`. The product must have a Meter Credit benefit attached to
# that meter, or a completed purchase grants nothing.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_CREDITS_METER_ID=
POLAR_SERVER=sandbox

# --- Observability ----------------------------------------------------------
# Leave SENTRY_DSN empty to disable reporting entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# 0..1 — defaults to 1.0 outside production, 0.1 in production
SENTRY_TRACES_SAMPLE_RATE=1.0
# true also sends request bodies, cookies and IPs; off by default because
# prompts and workspace paths flow through this API
SENTRY_SEND_PII=false
SENTRY_DEBUG=false
