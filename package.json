{
  "name": "codepilot",
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "test": "bun run --cwd packages/server test",
    "typecheck": "bun run typecheck:shared && bun run typecheck:server && bun run typecheck:cli",
    "typecheck:cli": "tsc --noEmit -p packages/cli",
    "typecheck:server": "tsc --noEmit -p packages/server",
    "typecheck:shared": "tsc --noEmit -p packages/shared"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}